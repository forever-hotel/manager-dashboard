[Unit]
Description=MAD public readiness observation

[Service]
Type=oneshot
User=mad-monitor
Group=mad-monitor
EnvironmentFile=/opt/mad/operations/monitor.env
ExecStart=/usr/bin/bash -o pipefail -c '/usr/bin/python3 /opt/mad/operations/operations_probe.py | /usr/bin/logger --tcp --server 127.0.0.1 --port 1514 --tag mad-monitor'
SyslogIdentifier=mad-monitor
NoNewPrivileges=true
PrivateTmp=true
