# =============================================================================
# Forever Hotel - Manager Dashboard (MAD)
# Frontend .env.local — consumed by Next.js (npm run dev) on your local machine
# Next.js automatically loads .env.local for local development overrides
# =============================================================================

# --- Backend API URL (prefixed with NEXT_PUBLIC_ so it is exposed to the browser bundle) ---
# Read anywhere in the frontend via process.env.NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=http://localhost:PORT
