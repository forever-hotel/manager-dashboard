{
  "name": "manager_dashboard_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:integration": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-sinhala": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.7",
    "amqplib": "^2.2.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdfkit": "0.20.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "operations/**/*.ts",
      "notifications/**/*.ts",
      "rooms/**/*.ts",
      "stock/**/*.ts",
      "reports/**/*.ts",
      "tasks/**/*.ts",
      "kitchen/**/*.ts",
      "realtime/**/*.ts",
      "complaints/**/*.ts",
      "promotions/**/*.ts",
      "staff/**/*.ts",
      "analytics/**/*.ts",
      "auth/**/*.ts",
      "config/**/*.ts",
      "common/**/*.ts",
      "health/**/*.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "./src/operations/operations.telemetry.ts": {
        "branches": 90
      },
      "./src/staff/staff-directory.service.ts": {
        "branches": 90
      },
      "./src/notifications/notifications.service.ts": {
        "branches": 90
      },
      "global": {
        "lines": 80,
        "branches": 80
      },
      "./src/auth/token.service.ts": {
        "branches": 90
      },
      "./src/auth/auth.service.ts": {
        "branches": 90
      },
      "./src/analytics/revenue-analytics.service.ts": {
        "branches": 90
      },
      "./src/analytics/booking-analytics.service.ts": {
        "branches": 90
      },
      "./src/analytics/occupancy-analytics.service.ts": {
        "branches": 90
      },
      "./src/staff/staff.service.ts": {
        "branches": 90
      },
      "./src/staff/staff-profiles.service.ts": {
        "branches": 90
      },
      "./src/staff/staff-delivery.worker.ts": {
        "branches": 90
      },
      "./src/promotions/promotions.service.ts": {
        "branches": 90
      },
      "./src/complaints/complaints.service.ts": {
        "branches": 90
      },
      "./src/analytics/food-analytics.service.ts": {
        "branches": 90
      },
      "./src/analytics/service-request-analytics.service.ts": {
        "branches": 90
      },
      "./src/analytics/worker-performance.service.ts": {
        "branches": 90
      },
      "./src/kitchen/kitchen.service.ts": {
        "branches": 90
      },
      "./src/tasks/tasks.service.ts": {
        "branches": 90
      },
      "./src/stock/stock-alerts.service.ts": {
        "branches": 90
      },
      "./src/rooms/rooms.service.ts": {
        "branches": 90
      }
    },
    "coverageProvider": "v8"
  },
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=10"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
