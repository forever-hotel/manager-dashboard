# =============================================================================
# Forever Hotel - Manager Dashboard (MAD)
# Backend .env — consumed by NestJS (npm run start:dev) on your local machine
# ConfigModule reads this file via envFilePath: '.env' in app.module.ts
# =============================================================================

# --- Server port (read via process.env.PORT in main.ts) ---
PORT=PORT

# --- CORS: URL the backend allows requests from (read via process.env.FRONTEND_URL in main.ts) ---
FRONTEND_URL=http://localhost:PORT

# --- Database (points to localhost because you run NestJS natively, not in Docker) ---
# Read via configService.get('DATABASE_URL') in database.module.ts
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/forever_hotel

# --- Node environment (read via configService.get('NODE_ENV') in database.module.ts for SQL logging) ---
NODE_ENV=development

# --- JWT (read via configService.get/getOrThrow('JWT_SECRET') in auth.module.ts and jwt-auth.guard.ts) ---
JWT_SECRET=fh-mad-dev-jwt-secret-2026-change-in-prod
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
