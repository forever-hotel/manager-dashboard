PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Hosted PostgreSQL. One variable per line; never commit real credentials.
DB_HOST=your-branch.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_USERNAME=your_database_role
DB_PASSWORD=replace-with-your-password
DB_NAME=forever
DB_SSL=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Optional initial ROOT: set email and username. A random password is generated and emailed once.
# Existing accounts are never reset. No INITIAL_MANAGER_PASSWORD is used.
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_USERNAME=

# DDP-011: fractional occupancy threshold, inclusive range 0..1.
LOW_BOOKING_THRESHOLD=0.40
MAD_PROMOTIONS_PUBLISH_ENABLED=false
# DDP-012: base64 of 32 random bytes; retain securely while deliveries are queued.

# Enable after manually applying the realtime section in docs/forever-hotel.sql.
MAD_REALTIME_ENABLED=false
RABBITMQ_URL=amqp://mad:mad-local-only@localhost:5672

# Generate a private random value of at least 32 characters; match the shared service registry.
MAD_WEBSOCKET_RELAY_KEY=replace-with-your-private-random-relay-key
SHARED_WEBSOCKET_URL=http://localhost:8081

# Authentication is owned by the API gateway.
AUTH_SERVICE_URL=http://localhost:8080
STAFF_EMAIL_ENABLED=true
BREVO_API_KEY=
STAFF_EMAIL_FROM=
STAFF_CREDENTIALS_KEY=

# Manual guest PII rollout: apply approved SQL, stop writers, convert, then enable.
GUEST_PII_ENABLED=false
GUEST_PII_REQUIRE_ENCRYPTED=false
# Base64 of 32 random bytes, shared ONLY by MAD/FDS/HW. Keep outside Git/backups.
GUEST_PII_KEY=
