# =============================================================================
# Forever Hotel - Manager Dashboard (MAD)
# Root .env — consumed by Docker Compose only
# Variables here override the defaults in docker-compose.yml
# =============================================================================

# --- Backend container ports ---
BACKEND_PORT=PORT
FRONTEND_PORT=PORT

# --- CORS: URL the backend allows requests from ---
FRONTEND_URL=http://localhost:PORT

# --- Database (points to the 'postgres' service name inside Docker network) ---
DATABASE_URL=postgresql://USERNAME:PASWORD@ADDRESS:PORT/DATABASE

# --- JWT ---
JWT_SECRET=fh-mad-dev-jwt-secret-2026-change-in-prod
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Frontend API URL (passed to Next.js at build time via Docker build arg) ---
NEXT_PUBLIC_API_URL=http://localhost:PORT
