# Local Compose configuration. Replace these values for any shared environment.
BACKEND_PORT=4000
# Local broker only. If changing the password, update the URL too (URL-encode it).
RABBITMQ_PASSWORD=mad-local-only
RABBITMQ_URL=amqp://mad:mad-local-only@mad-rabbitmq:5672
MAD_SOCKET_PUBLIC_URL=http://localhost:8080
GATEWAY_PORT=8080
API_GATEWAY_CONTEXT=./api-gateway
FRONTEND_PORT=3000
JWT_SECRET=local-only-change-this-signing-secret-before-deployment
JWT_ISSUER=mad
FRONTEND_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Compose wires the frontend to http://api-gateway:8080 internally.
# Host-run frontend settings belong in frontend/.env.local.

# Hosted PostgreSQL. One variable per line; never commit real credentials.
DB_HOST=your-branch.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_USERNAME=your_database_role
DB_PASSWORD=replace-with-your-password
DB_NAME=forever
DB_SSL=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Optional initial manager. Set all three in your private .env to enable.
# Existing accounts are never reset, even after changing these values.
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_USERNAME=
INITIAL_MANAGER_PASSWORD=

# DDP-011: fractional occupancy threshold, inclusive range 0..1.
LOW_BOOKING_THRESHOLD=0.40
# DDP-040: enable only after manual publication SQL and HW queue/consumer setup.
MAD_PROMOTIONS_PUBLISH_ENABLED=false
# DDP-012: base64 of 32 random bytes; retain securely while deliveries are queued.
STAFF_CREDENTIALS_KEY=
# Enable only after configuring a verified SendGrid sender and Mail Send API key.
STAFF_EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Generate a private random value of at least 32 characters; match the shared service registry.
MAD_WEBSOCKET_RELAY_KEY=replace-with-your-private-random-relay-key
SHARED_WEBSOCKET_URL=http://localhost:4700
