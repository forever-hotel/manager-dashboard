# Local Compose configuration. Replace these values for any shared environment.
BACKEND_PORT=4000
GATEWAY_PORT=8080
API_GATEWAY_CONTEXT=./api-gateway
FRONTEND_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=local-postgres-password
MAD_DB_PASSWORD=local-mad-password
JWT_SECRET=local-only-change-this-signing-secret-before-deployment
JWT_ISSUER=mad
FRONTEND_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Compose wires the frontend to http://api-gateway:8080 internally.
# Host-run frontend settings belong in frontend/.env.local.
